{
  "expo": {
    "name": "Finance Flow",
    "slug": "finance_flow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/icon.png",
    "scheme": "financeflow",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-fg.png",
        "backgroundColor": "#f3f2f2"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.finance_flow"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6dc1ee93-7718-4ba3-85e7-aeb02271b16f"
      }
    },
    "owner": "venkat1218",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/6dc1ee93-7718-4ba3-85e7-aeb02271b16f",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
